# App deployment mode: "selfhosted" (default) or "saas"
# selfhosted → shows technical setup guides when broker/services are unreachable
# saas       → shows user-friendly "service unavailable, contact support" messages instead
PUBLIC_APP_MODE=selfhosted

DATABASE_URL="mysql://kael:@127.0.0.1:3306/portfolio"
REDIS_URL=redis://localhost:6379
LARAVEL_API_URL="http://127.0.0.1:8000/api"
LARAVEL_API_TOKEN=""
MOOMOO_SERVICE_URL="http://127.0.0.1:8001"
MOOMOO_OPEND_PATH=""
AI_COPILOT_ENABLED=true
AI_PROVIDER=claude
ANTHROPIC_API_KEY=""
AI_MODEL=claude-haiku-4-5-20251001
AI_MAX_TOKENS=1200
AI_TEMPERATURE=0.2
AI_CHAT_RATE_LIMIT_PER_MINUTE=10
AI_STORE_FULL_PROMPTS=false
OPENAI_API_KEY=""
FINNHUB_API_KEY=""
AI_ORCHESTRATION_ENABLED=true
AI_PROVIDER_OPENAI_ENABLED=true
AI_PROVIDER_CLAUDE_ENABLED=false
AI_PROVIDER_GEMINI_ENABLED=false
GEMINI_API_KEY=""
AI_GEMINI_MODEL=gemini-2.5-flash
AI_PROVIDER_OLLAMA_ENABLED=true
AI_OLLAMA_URL=http://localhost:11434
AI_OLLAMA_MODEL=llama3.2:3b
AI_ENABLE_TOOL_CALLING=true
AI_ENABLE_MEMORY=true
AI_ENABLE_PROVIDER_ROUTING=true
AI_MAX_CONTEXT_TOKENS=12000
AI_MEMORY_COMPRESSION_ENABLED=true
AI_PORTFOLIO_ASSISTANT_ENABLED=true
AI_PORTFOLIO_ASSISTANT_CACHE_TTL=600
AI_RISK_ADVISOR_ENABLED=true
AI_RISK_ADVISOR_CACHE_TTL=600
OPTIMIZATION_ENGINE_ENABLED=true
OPTIMIZATION_PROVIDER=sveltekit
RISKFOLIO_ENABLED=false
MAX_OPTIMIZATION_RUNS_PER_DAY=20
SMART_ALLOCATION_ENABLED=true
SMART_ALLOCATION_CACHE_TTL=600
OPTIONS_INTELLIGENCE_ENABLED=true
MAX_OPTIONS_ALLOCATION=20
OPTIONS_RISK_MODE=moderate
SCENARIO_SIMULATION_ENABLED=true
STRESS_TESTING_ENABLED=true
MAX_SIMULATION_RUNS_PER_DAY=20
STRATEGY_ORCHESTRATOR_ENABLED=true
MAX_STRATEGY_REFRESH_PER_DAY=20
PORTFOLIO_MODE_DYNAMIC=true
TRADE_LAYER_ENABLED=true
TRADE_EXECUTION_ENABLED=false
MOOMOO_LIVE_EXECUTION_ENABLED=false
MOOMOO_DRY_RUN_EXECUTION=true
MAX_TRADE_TICKETS_PER_DAY=20
