generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id               String              @id @default(cuid())
  name             String
  email            String              @unique
  passwordHash     String
  baseCurrency     String              @default("USD")
  accounts         Account[]
  transactions     Transaction[]
  holdingSnaps     HoldingSnapshot[]
  watchlists       Watchlist[]
  portfolioSnaps   PortfolioSnapshot[]
  brokerSyncLogs   BrokerSyncLog[]
  aiMemories       AiMemory[]
  aiConversations  AiConversation[]
  aiMessages       AiMessage[]
  aiInsights       AiInsight[]
  aiUsageLogs      AiUsageLog[]
  aiPromptLogs     AiPromptLog[]
  aiMemorySnapshots AiMemorySnapshot[]
  aiMemoryTimelines AiMemoryTimeline[]
  aiHistoricalInsights AiHistoricalInsight[]
  aiOrchestrationLogs AiOrchestrationLog[]
  aiToolExecutionLogs AiToolExecutionLog[]
  aiMemoryBlocks AiMemoryBlock[]
  aiPortfolioNarratives AiPortfolioNarrative[]
  aiPortfolioExplanations AiPortfolioExplanation[]
  aiRiskNarratives AiRiskNarrative[]
  aiRiskAlerts AiRiskAlert[]
  aiRiskExplanations AiRiskExplanation[]
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
}

model Account {
  id             String            @id @default(cuid())
  userId         String
  user           User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  name           String
  brokerName     String
  accountType    String
  currency       String            @default("USD")
  transactions   Transaction[]
  holdingSnaps   HoldingSnapshot[]
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@unique([id, userId])
  @@index([userId])
}

model Asset {
  id             String            @id @default(cuid())
  symbol         String            @unique
  name           String
  assetType      String
  exchange       String?
  currency       String            @default("USD")
  sector         String?
  country        String?
  latestPrice    Float             @default(0)
  transactions   Transaction[]
  holdingSnaps   HoldingSnapshot[]
  watchlistItems WatchlistItem[]
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
}

model Transaction {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountId   String
  account     Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  assetId     String?
  asset       Asset?    @relation(fields: [assetId], references: [id], onDelete: SetNull)
  type        String
  tradeDate   DateTime
  quantity    Float     @default(0)
  price       Float     @default(0)
  fee         Float     @default(0)
  currency    String    @default("USD")
  notes       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([id, userId])
  @@index([userId, tradeDate])
  @@index([accountId])
  @@index([assetId])
}

model HoldingSnapshot {
  id             String    @id @default(cuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountId      String
  account        Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  assetId        String
  asset          Asset     @relation(fields: [assetId], references: [id], onDelete: Cascade)
  date           DateTime
  quantity       Float
  averageCost    Float
  marketPrice    Float
  marketValue    Float
  unrealizedPnl  Float
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([userId, accountId, assetId, date])
  @@index([userId, date])
}

model Watchlist {
  id        String          @id @default(cuid())
  userId    String
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  items     WatchlistItem[]
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  @@unique([id, userId])
  @@index([userId])
}

model WatchlistItem {
  id          String    @id @default(cuid())
  watchlistId String
  watchlist   Watchlist @relation(fields: [watchlistId], references: [id], onDelete: Cascade)
  assetId     String
  asset       Asset     @relation(fields: [assetId], references: [id], onDelete: Cascade)
  notes       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([watchlistId, assetId])
}

model PortfolioSnapshot {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  snapshotDate   DateTime
  totalValue     Float
  cashBalance    Float    @default(0)
  holdingsCount  Int      @default(0)
  holdingsJson   String   @db.LongText
  allocationJson String   @db.LongText
  createdAt      DateTime @default(now())

  @@unique([userId, snapshotDate])
  @@index([userId, snapshotDate])
}

model BrokerSyncLog {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  broker       String
  status       String
  recordCount  Int      @default(0)
  errorMessage String?  @db.Text
  createdAt    DateTime @default(now())

  @@index([userId, createdAt])
}

model AiMemory {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  contextType String   @db.VarChar(40)
  period      String   @db.VarChar(10)
  benchmark   String   @db.VarChar(20)
  contextHash String   @db.VarChar(64)
  payloadJson String   @db.LongText
  promptJson  String?  @db.LongText
  summary     String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([userId, contextType, period, benchmark, contextHash])
  @@index([userId, contextType, createdAt])
}

model AiMemorySnapshot {
  id                    String             @id @default(cuid())
  userId                String             @map("user_id")
  user                  User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  snapshotType          String             @map("snapshot_type") @db.VarChar(60)
  snapshotVersion       String             @map("snapshot_version") @db.VarChar(30)
  contextJson           String             @map("context_json") @db.LongText
  compressedContextJson String             @map("compressed_context_json") @db.LongText
  summary               String             @db.Text
  metadataJson          String             @map("metadata") @db.LongText
  timelines             AiMemoryTimeline[]
  createdAt             DateTime           @default(now()) @map("created_at")
  updatedAt             DateTime           @updatedAt @map("updated_at")

  @@index([userId, snapshotType, createdAt])
  @@map("ai_memory_snapshots")
}

model AiMemoryTimeline {
  id               String           @id @default(cuid())
  userId           String           @map("user_id")
  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  memorySnapshotId String           @map("memory_snapshot_id")
  memorySnapshot   AiMemorySnapshot @relation(fields: [memorySnapshotId], references: [id], onDelete: Cascade)
  timelineType     String           @map("timeline_type") @db.VarChar(60)
  timelineKey      String           @map("timeline_key") @db.VarChar(120)
  timelineValue    String           @map("timeline_value") @db.Text
  metadataJson     String           @map("metadata") @db.LongText
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")

  @@index([userId, timelineType, createdAt])
  @@index([memorySnapshotId])
  @@map("ai_memory_timelines")
}

model AiHistoricalInsight {
  id               String   @id @default(cuid())
  userId           String   @map("user_id")
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  insightType      String   @map("insight_type") @db.VarChar(60)
  title            String
  summary          String   @db.Text
  contextReference String   @map("context_reference") @db.VarChar(120)
  metadataJson     String   @map("metadata") @db.LongText
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@index([userId, insightType, createdAt])
  @@map("ai_historical_insights")
}

model AiConversation {
  id              String      @id @default(cuid())
  userId          String
  user            User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  portfolioId     String?
  activeAccountId String?
  title           String
  status          String      @default("active")
  metadataJson    String      @db.LongText
  messages        AiMessage[]
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@unique([id, userId])
  @@index([userId, createdAt])
  @@map("ai_conversations")
}

model AiMessage {
  id                String         @id @default(cuid())
  aiConversationId String
  conversation      AiConversation @relation(fields: [aiConversationId], references: [id], onDelete: Cascade)
  userId            String
  user              User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  role              String
  content           String         @db.LongText
  contextSnapshotId String?
  metadataJson      String         @db.LongText
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  @@index([aiConversationId, createdAt])
  @@index([userId, createdAt])
  @@map("ai_messages")
}

model AiInsight {
  id                  String    @id @default(cuid())
  userId              String
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  portfolioSnapshotId String?
  activeAccountId     String?
  insightType         String
  title               String
  summary             String    @db.Text
  riskLevel           String
  contentJson         String    @db.LongText
  expiresAt           DateTime?
  metadataJson        String    @db.LongText
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@index([userId, insightType, createdAt])
  @@map("ai_insights")
}

model AiPromptTemplate {
  id                 String   @id @default(cuid())
  name               String
  slug               String
  version            String   @default("phase-5.0")
  systemPrompt       String   @db.LongText
  userPromptTemplate String   @db.LongText
  isActive           Boolean  @default(true)
  metadataJson       String   @db.LongText
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@unique([slug, version])
  @@index([slug, isActive])
  @@map("ai_prompt_templates")
}

model AiUsageLog {
  id               String   @id @default(cuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider         String
  model            String
  promptTokens     Int      @default(0)
  completionTokens Int      @default(0)
  totalTokens      Int      @default(0)
  costEstimate     Float    @default(0)
  requestType      String
  metadataJson     String   @db.LongText
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([userId, provider, createdAt])
  @@map("ai_usage_logs")
}

model AiPromptLog {
  id               String   @id @default(cuid())
  userId           String   @map("user_id")
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  promptType       String   @map("prompt_type") @db.VarChar(60)
  provider         String   @db.VarChar(40)
  model            String   @db.VarChar(80)
  promptTokens     Int      @default(0) @map("prompt_tokens")
  compressedTokens Int      @default(0) @map("compressed_tokens")
  status           String   @default("ready") @db.VarChar(40)
  metadataJson     String   @map("metadata") @db.LongText
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@index([userId, promptType, createdAt])
  @@map("ai_prompt_logs")
}

model AiOrchestrationLog {
  id                String   @id @default(cuid())
  userId            String   @map("user_id")
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversationId    String?  @map("conversation_id")
  intentType        String   @map("intent_type") @db.VarChar(60)
  provider          String   @db.VarChar(40)
  model             String   @db.VarChar(80)
  confidence        String   @db.VarChar(20)
  toolCallsJson     String   @map("tool_calls_json") @db.LongText
  sourceContextsJson String  @map("source_contexts_json") @db.LongText
  responseTimeMs    Int      @default(0) @map("response_time_ms")
  status            String   @default("completed") @db.VarChar(40)
  metadataJson      String   @map("metadata") @db.LongText
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  @@index([userId, intentType, createdAt])
  @@index([conversationId])
  @@map("ai_orchestration_logs")
}

model AiToolExecutionLog {
  id              String   @id @default(cuid())
  userId          String   @map("user_id")
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  toolName        String   @map("tool_name") @db.VarChar(80)
  executionStatus String   @map("execution_status") @db.VarChar(40)
  executionTimeMs Int      @default(0) @map("execution_time_ms")
  inputJson       String   @map("input_json") @db.LongText
  outputJson      String   @map("output_json") @db.LongText
  metadataJson    String   @map("metadata") @db.LongText
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@index([userId, toolName, createdAt])
  @@map("ai_tool_execution_logs")
}

model AiMemoryBlock {
  id              String   @id @default(cuid())
  userId          String   @map("user_id")
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversationId  String?  @map("conversation_id")
  memoryType      String   @map("memory_type") @db.VarChar(60)
  summary         String   @db.Text
  importanceScore Float    @default(0.5) @map("importance_score")
  metadataJson    String   @map("metadata") @db.LongText
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@index([userId, memoryType, createdAt])
  @@index([conversationId])
  @@map("ai_memory_blocks")
}

model AiPortfolioNarrative {
  id                  String   @id @default(cuid())
  userId              String   @map("user_id")
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  portfolioSnapshotId String?  @map("portfolio_snapshot_id")
  activeAccountId     String?  @map("active_account_id")
  title               String
  summary             String   @db.Text
  narrative           String   @db.LongText
  riskLevel           String   @map("risk_level") @db.VarChar(30)
  metadataJson        String   @map("metadata") @db.LongText
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  @@index([userId, createdAt])
  @@map("ai_portfolio_narratives")
}

model AiPortfolioExplanation {
  id              String   @id @default(cuid())
  userId          String   @map("user_id")
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  explanationType String   @map("explanation_type") @db.VarChar(40)
  question        String   @db.Text
  responseJson    String   @map("response") @db.LongText
  contextHash     String   @map("context_hash") @db.VarChar(64)
  metadataJson    String   @map("metadata") @db.LongText
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@index([userId, explanationType, createdAt])
  @@index([contextHash])
  @@map("ai_portfolio_explanations")
}

model AiRiskNarrative {
  id                  String   @id @default(cuid())
  userId              String   @map("user_id")
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  portfolioSnapshotId String?  @map("portfolio_snapshot_id")
  activeAccountId     String?  @map("active_account_id")
  riskLevel           String   @map("risk_level") @db.VarChar(40)
  summary             String   @db.Text
  narrative           String   @db.LongText
  warningsJson        String   @map("warnings_json") @db.LongText
  metadataJson        String   @map("metadata") @db.LongText
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  @@index([userId, riskLevel, createdAt])
  @@map("ai_risk_narratives")
}

model AiRiskAlert {
  id           String    @id @default(cuid())
  userId       String    @map("user_id")
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  alertType    String    @map("alert_type") @db.VarChar(60)
  severity     String    @db.VarChar(30)
  message      String    @db.Text
  status       String    @default("active") @db.VarChar(30)
  expiresAt    DateTime? @map("expires_at")
  metadataJson String    @map("metadata") @db.LongText
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  @@index([userId, alertType, status, createdAt])
  @@map("ai_risk_alerts")
}

model AiRiskExplanation {
  id              String   @id @default(cuid())
  userId          String   @map("user_id")
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  explanationType String   @map("explanation_type") @db.VarChar(40)
  question        String   @db.Text
  responseJson    String   @map("response") @db.LongText
  contextHash     String   @map("context_hash") @db.VarChar(64)
  metadataJson    String   @map("metadata") @db.LongText
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@index([userId, explanationType, createdAt])
  @@index([contextHash])
  @@map("ai_risk_explanations")
}

model AnalyticsCache {
  id          String   @id @default(cuid())
  userId      String   @map("user_id")
  cacheKey    String   @unique @map("cache_key")
  cacheType   String   @map("cache_type")
  payloadJson String   @map("payload_json") @db.LongText
  generatedAt DateTime @map("generated_at")
  expiresAt   DateTime @map("expires_at")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([userId, cacheType, expiresAt])
  @@map("analytics_cache")
}

model BenchmarkPrice {
  id        String   @id @default(cuid())
  symbol    String
  date      DateTime
  open      Float
  high      Float
  low       Float
  close     Float
  adjClose  Float    @map("adj_close")
  volume    Float    @default(0)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([symbol, date])
  @@index([symbol, date])
  @@map("benchmark_prices")
}

model BenchmarkPerformanceMetric {
  id               String   @id @default(cuid())
  userId           String   @map("user_id")
  benchmarkSymbol  String   @map("benchmark_symbol")
  snapshotDate     DateTime @map("snapshot_date")
  portfolioReturn  Float    @map("portfolio_return")
  benchmarkReturn  Float    @map("benchmark_return")
  relativeReturn   Float    @map("relative_return")
  alpha            Float
  beta             Float
  sharpeRatio      Float    @map("sharpe_ratio")
  sortinoRatio     Float    @map("sortino_ratio")
  trackingError    Float    @map("tracking_error")
  informationRatio Float    @map("information_ratio")
  metadataJson     String   @map("metadata") @db.LongText
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@unique([userId, benchmarkSymbol, snapshotDate])
  @@index([userId, benchmarkSymbol, snapshotDate])
  @@map("benchmark_performance_metrics")
}

model RollingPerformanceMetric {
  id                   String   @id @default(cuid())
  userId               String   @map("user_id")
  benchmarkSymbol      String   @map("benchmark_symbol")
  period               String
  snapshotDate         DateTime @map("snapshot_date")
  portfolioReturn      Float    @map("portfolio_return")
  benchmarkReturn      Float    @map("benchmark_return")
  relativeStrength     Float    @map("relative_strength")
  volatilityDifference Float    @map("volatility_difference")
  metadataJson         String   @map("metadata") @db.LongText
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  @@unique([userId, benchmarkSymbol, period, snapshotDate])
  @@index([userId, benchmarkSymbol, period, snapshotDate])
  @@map("rolling_performance_metrics")
}

model PerformanceAttributionReport {
  id                     String   @id @default(cuid())
  userId                 String   @map("user_id")
  benchmarkSymbol        String   @map("benchmark_symbol")
  snapshotDate           DateTime @map("snapshot_date")
  sectorContributionJson String   @map("sector_contribution_json") @db.LongText
  assetContributionJson  String   @map("asset_contribution_json") @db.LongText
  riskContributionJson   String   @map("risk_contribution_json") @db.LongText
  metadataJson           String   @map("metadata") @db.LongText
  createdAt              DateTime @default(now()) @map("created_at")
  updatedAt              DateTime @updatedAt @map("updated_at")

  @@unique([userId, benchmarkSymbol, snapshotDate])
  @@index([userId, benchmarkSymbol, snapshotDate])
  @@map("performance_attribution_reports")
}

model PortfolioDailyReturn {
  id               String   @id @default(cuid())
  userId           String   @map("user_id")
  snapshotDate     DateTime @map("snapshot_date")
  portfolioValue   Float    @map("portfolio_value")
  dailyReturn      Float    @map("daily_return")
  cumulativeReturn Float    @map("cumulative_return")
  benchmarkReturn  Float    @default(0) @map("benchmark_return")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@unique([userId, snapshotDate])
  @@index([userId, snapshotDate])
  @@map("portfolio_daily_returns")
}

model PortfolioMetric {
  id               String                      @id @default(cuid())
  userId           String                      @map("user_id")
  tradingAccountId String?                     @map("trading_account_id")
  snapshotDate     DateTime                    @map("snapshot_date")
  totalValue       Float                       @map("total_value")
  cashValue        Float                       @map("cash_value")
  marketValue      Float                       @map("market_value")
  costBasis        Float                       @map("cost_basis")
  unrealizedPnl    Float                       @map("unrealized_pnl")
  realizedPnl      Float                       @map("realized_pnl")
  dividendIncome   Float                       @default(0) @map("dividend_income")
  feesPaid         Float                       @default(0) @map("fees_paid")
  totalReturn      Float                       @map("total_return")
  totalReturnPct   Float                       @map("total_return_percent")
  dailyReturn      Float                       @default(0) @map("daily_return")
  monthlyReturn    Float                       @default(0) @map("monthly_return")
  ytdReturn        Float                       @default(0) @map("ytd_return")
  currency         String                      @default("USD")
  metadataJson     String                      @map("metadata") @db.LongText
  allocations      PortfolioMetricAllocation[]
  createdAt        DateTime                    @default(now()) @map("created_at")
  updatedAt        DateTime                    @updatedAt @map("updated_at")

  @@unique([userId, tradingAccountId, snapshotDate])
  @@index([userId, snapshotDate])
  @@map("portfolio_metrics")
}

model PortfolioMetricAllocation {
  id                String          @id @default(cuid())
  portfolioMetricId String          @map("portfolio_metric_id")
  portfolioMetric   PortfolioMetric @relation(fields: [portfolioMetricId], references: [id], onDelete: Cascade)
  allocationType    String          @map("allocation_type")
  allocationKey     String          @map("allocation_key")
  marketValue       Float           @map("market_value")
  allocationPercent Float           @map("allocation_percent")
  metadataJson      String          @map("metadata") @db.LongText
  createdAt         DateTime        @default(now()) @map("created_at")
  updatedAt         DateTime        @updatedAt @map("updated_at")

  @@unique([portfolioMetricId, allocationType, allocationKey])
  @@index([allocationType, allocationKey])
  @@map("portfolio_metric_allocations")
}

model PortfolioReturnHistory {
  id               String   @id @default(cuid())
  userId           String   @map("user_id")
  tradingAccountId String?  @map("trading_account_id")
  date             DateTime
  portfolioValue   Float    @map("portfolio_value")
  cashValue        Float    @map("cash_value")
  marketValue      Float    @map("market_value")
  netDeposit       Float    @map("net_deposit")
  dailyReturn      Float    @default(0) @map("daily_return")
  cumulativeReturn Float    @default(0) @map("cumulative_return")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@unique([userId, tradingAccountId, date])
  @@index([userId, date])
  @@map("portfolio_return_history")
}

model PortfolioRiskMetric {
  id                   String   @id @default(cuid())
  userId               String   @map("user_id")
  tradingAccountId     String?  @map("trading_account_id")
  snapshotDate         DateTime @map("snapshot_date")
  volatility           Float
  maxDrawdown          Float    @map("max_drawdown")
  concentrationScore   Float    @map("concentration_score")
  diversificationScore Float    @map("diversification_score")
  riskScore            Float    @map("risk_score")
  riskLevel            String   @map("risk_level")
  portfolioHealth      String   @map("portfolio_health")
  metadataJson         String   @map("metadata") @db.LongText
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  @@unique([userId, tradingAccountId, snapshotDate])
  @@index([userId, snapshotDate])
  @@map("portfolio_risk_metrics")
}

model PortfolioExposure {
  id                String   @id @default(cuid())
  userId            String   @map("user_id")
  snapshotDate      DateTime @map("snapshot_date")
  exposureType      String   @map("exposure_type")
  exposureKey       String   @map("exposure_key")
  marketValue       Float    @map("market_value")
  allocationPercent Float    @map("allocation_percent")
  riskContribution  Float    @map("risk_contribution")
  metadataJson      String   @map("metadata") @db.LongText
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  @@unique([userId, snapshotDate, exposureType, exposureKey])
  @@index([userId, exposureType, snapshotDate])
  @@map("portfolio_exposures")
}

model PortfolioCorrelation {
  id               String   @id @default(cuid())
  userId           String   @map("user_id")
  snapshotDate     DateTime @map("snapshot_date")
  assetA           String   @map("asset_a")
  assetB           String   @map("asset_b")
  correlationValue Float    @map("correlation_value")
  metadataJson     String   @map("metadata") @db.LongText
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@unique([userId, snapshotDate, assetA, assetB])
  @@index([userId, snapshotDate])
  @@map("portfolio_correlations")
}

model PortfolioHealthReport {
  id                  String   @id @default(cuid())
  userId              String   @map("user_id")
  snapshotDate        DateTime @map("snapshot_date")
  healthScore         Float    @map("health_score")
  riskLevel           String   @map("risk_level")
  strengthsJson       String   @map("strengths_json") @db.LongText
  weaknessesJson      String   @map("weaknesses_json") @db.LongText
  recommendationsJson String   @map("recommendations_json") @db.LongText
  metadataJson        String   @map("metadata") @db.LongText
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  @@unique([userId, snapshotDate])
  @@index([userId, snapshotDate])
  @@map("portfolio_health_reports")
}
