  cashValue        Float    @map("cash_value")
  marketValue      Float    @map("market_value")
  netDeposit       Float    @map("net_deposit")
  dailyReturn      Float    @default(0) @map("daily_return")
  cumulativeReturn Float    @default(0) @map("cumulative_return")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@unique([userId, tradingAccountId, date])
  @@index([userId, date])
  @@map("portfolio_return_history")
}

model PortfolioRiskMetric {
  id                   String   @id @default(cuid())
  userId               String   @map("user_id")
  tradingAccountId     String?  @map("trading_account_id")
  snapshotDate         DateTime @map("snapshot_date")
  volatility           Float
  maxDrawdown          Float    @map("max_drawdown")
  concentrationScore   Float    @map("concentration_score")
  diversificationScore Float    @map("diversification_score")
  riskScore            Float    @map("risk_score")
  riskLevel            String   @map("risk_level")
  portfolioHealth      String   @map("portfolio_health")
  metadataJson         String   @map("metadata") @db.LongText
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  @@unique([userId, tradingAccountId, snapshotDate])
  @@index([userId, snapshotDate])
  @@map("portfolio_risk_metrics")
}

model PortfolioExposure {
  id                String   @id @default(cuid())
  userId            String   @map("user_id")
  snapshotDate      DateTime @map("snapshot_date")
  exposureType      String   @map("exposure_type")
  exposureKey       String   @map("exposure_key")
  marketValue       Float    @map("market_value")
  allocationPercent Float    @map("allocation_percent")
  riskContribution  Float    @map("risk_contribution")
  metadataJson      String   @map("metadata") @db.LongText
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  @@unique([userId, snapshotDate, exposureType, exposureKey])
  @@index([userId, exposureType, snapshotDate])
  @@map("portfolio_exposures")
}

model PortfolioCorrelation {
  id               String   @id @default(cuid())
  userId           String   @map("user_id")
  snapshotDate     DateTime @map("snapshot_date")
  assetA           String   @map("asset_a")
  assetB           String   @map("asset_b")
  correlationValue Float    @map("correlation_value")
  metadataJson     String   @map("metadata") @db.LongText
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@unique([userId, snapshotDate, assetA, assetB])
  @@index([userId, snapshotDate])
  @@map("portfolio_correlations")
}

model PortfolioHealthReport {
  id                  String   @id @default(cuid())
  userId              String   @map("user_id")
  snapshotDate        DateTime @map("snapshot_date")
  healthScore         Float    @map("health_score")
  riskLevel           String   @map("risk_level")
  strengthsJson       String   @map("strengths_json") @db.LongText
  weaknessesJson      String   @map("weaknesses_json") @db.LongText
  recommendationsJson String   @map("recommendations_json") @db.LongText
  metadataJson        String   @map("metadata") @db.LongText
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  @@unique([userId, snapshotDate])
  @@index([userId, snapshotDate])
  @@map("portfolio_health_reports")
}

model OptionAlert {
  id             String    @id @default(cuid())
  userId         String    @db.VarChar(191)
  symbol         String    @db.VarChar(50)
  optionType     String    @db.VarChar(30)
  severity       String    @db.VarChar(20)
  message        String    @db.Text
  recommendation String    @db.Text
  positionJson   String    @db.LongText
  detectedAt     DateTime  @default(now())
  acknowledged   Boolean   @default(false)
  acknowledgedAt DateTime?
  createdAt      DateTime  @default(now())

  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, detectedAt])
  @@index([userId, acknowledged])
}
